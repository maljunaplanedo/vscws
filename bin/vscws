#!/usr/bin/env bash
# vscws — write a VS Code dev container config into a project directory from a language preset.
# bash 3.2 compatible (macOS default). Needs jq.
set -euo pipefail

VSCWS_VERSION="0.2.0"

die()  { printf 'vscws: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

usage() {
  cat <<'EOF'
Usage: vscws DIR --preset NAME    write DIR/.devcontainer/ from preset NAME
       vscws --presets            list presets
       vscws --version | --help

If DIR/.devcontainer/devcontainer.json already exists, vscws shows the changes
and asks before merging. Your existing values win over the preset's.

Environment:
  VSCWS_CLAUDE_DIR   Claude config directory shared into the container (default ~/.claude)
EOF
}

# Directory of the real script, following symlinks without readlink -f (macOS).
resolve_self_dir() {
  local src="$0" dir
  while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd -P)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd "$(dirname "$src")" && pwd -P
}

BIN_DIR="$(resolve_self_dir)"
PRESETS_DIR="${VSCWS_PRESETS_DIR:-$(cd "$BIN_DIR/.." && pwd -P)/presets}"
CLAUDE_DIR="${VSCWS_CLAUDE_DIR:-$HOME/.claude}"

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed (see README: Prerequisites)"; }

host_networking() { case "$(uname -s)" in Darwin) echo false ;; *) echo true ;; esac; }

list_presets() {
  local d name desc
  for d in "$PRESETS_DIR"/*/; do
    [ -f "$d/devcontainer.json" ] || continue
    name="$(basename "$d")"
    desc="$(jq -r '.description // ""' "$d/devcontainer.json")"
    printf '%-10s %s\n' "$name" "$desc"
  done
}

JQ_MERGE_DEFS='
  def dedupe: reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);
  def merge(a; b):
    (a) as $a | (b) as $b |
    if ($a | type) == "object" and ($b | type) == "object" then
      reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = merge($a[$k]; $b[$k]))
    elif ($a | type) == "array" and ($b | type) == "array" then ($a + $b | dedupe)
    else $b end;
'

# render PRESET NAME  -> stdout: _common.json + preset merged, with name, Claude dir and host networking applied.
render() {
  local preset="$1" name="$2"
  jq -s --arg name "$name" --arg claude_dir "$CLAUDE_DIR" --arg hostnet "$(host_networking)" "$JQ_MERGE_DEFS"'
    merge(.[0]; .[1])
    | del(.description)
    | .name = $name
    | if .build then del(.image) else . end
    | .mounts = ((.mounts // []) | map(if type == "string" then gsub("__VSCWS_CLAUDE_DIR__"; $claude_dir) else . end))
    | if $hostnet == "true" then .runArgs = (((.runArgs // []) + ["--network=host"]) | dedupe) else . end
  ' "$PRESETS_DIR/_common.json" "$PRESETS_DIR/$preset/devcontainer.json"
}

# merge_existing GENERATED EXISTING -> stdout: existing values win, arrays appended; image/build kept consistent with existing.
merge_existing() {
  jq -s "$JQ_MERGE_DEFS"'
    .[1] as $e
    | merge(.[0]; $e)
    | if $e.build then del(.image) elif $e.image then del(.build) else . end
  ' "$1" "$2"
}

# copy_preset_files SRC DST [keep]: copy every file except devcontainer.json, dotfiles included; with "keep", never overwrite.
copy_preset_files() {
  local src="$1" dst="$2" keep="${3:-}" f base
  for f in "$src"/* "$src"/.[!.]* "$src"/..?*; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    [ "$base" = devcontainer.json ] && continue
    if [ -n "$keep" ] && [ -e "$dst/$base" ]; then info "kept existing $dst/$base"; continue; fi
    cp -R "$f" "$dst/"
  done
}

main() {
  local dir="" preset="" name target tmp existing answer
  [ $# -gt 0 ] || { usage >&2; exit 1; }
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)    usage; exit 0 ;;
      -v|--version) info "vscws $VSCWS_VERSION"; exit 0 ;;
      --presets)    need jq; list_presets; exit 0 ;;
      --preset)     [ $# -ge 2 ] || die "--preset needs a value"; preset="$2"; shift 2 ;;
      --)           shift; break ;;
      -*)           die "unknown option '$1' (try: vscws --help)" ;;
      *)            [ -z "$dir" ] || die "unexpected argument '$1'"; dir="$1"; shift ;;
    esac
  done
  if [ $# -gt 0 ]; then [ -z "$dir" ] || die "unexpected argument '$1'"; dir="$1"; shift; fi
  [ $# -eq 0 ] || die "unexpected argument '$1'"
  [ -n "$dir" ]    || die "usage: vscws DIR --preset NAME"
  [ -n "$preset" ] || die "--preset is required (see: vscws --presets)"
  need jq
  [ -f "$PRESETS_DIR/$preset/devcontainer.json" ] || die "unknown preset '$preset' (see: vscws --presets)"

  mkdir -p "$dir" || die "cannot create directory $dir"
  dir="$(cd "$dir" && pwd -P)" || die "cannot access $dir"
  name="$(basename "$dir")"
  target="$dir/.devcontainer"
  existing="$target/devcontainer.json"
  if [ -e "$target" ] && [ ! -f "$existing" ]; then
    die "$target exists but has no devcontainer.json; remove it or add one"
  fi

  tmp="$(mktemp -d "$dir/.devcontainer.tmp.XXXXXX")" || die "cannot write to $dir"
  trap 'rm -rf "$tmp"' EXIT
  render "$preset" "$name" > "$tmp/devcontainer.json"
  copy_preset_files "$PRESETS_DIR/$preset" "$tmp"

  if [ -f "$existing" ]; then
    jq -e 'type == "object"' "$existing" >/dev/null 2>&1 || die "$existing is not a JSON object (comments?), merge it by hand"
    merge_existing "$tmp/devcontainer.json" "$existing" > "$tmp/merged.json"
    if [ -f "$tmp/Dockerfile" ] && ! jq -e '.build' "$tmp/merged.json" >/dev/null 2>&1; then
      rm -f "$tmp/Dockerfile"
      info "note: existing \"image\" kept, preset's Dockerfile not used (remove \"image\" from devcontainer.json to switch to the preset's build)"
    fi
    info "$existing already exists. Changes the preset would make (your values win, file gets reformatted):"
    diff -u <(jq -S . "$existing") <(jq -S . "$tmp/merged.json") || true
    printf 'Merge into %s? [y/N] ' "$target"
    read -r answer || answer=""
    case "$answer" in y|Y|yes|YES) ;; *) die "aborted, nothing changed" ;; esac
    mv "$tmp/merged.json" "$existing"
    copy_preset_files "$tmp" "$target" keep
    rm -rf "$tmp"
    info "merged preset '$preset' into $target"
  else
    mv "$tmp" "$target"
    info "wrote $target (preset: $preset)"
  fi
  trap - EXIT
  info "next: open $dir in VS Code and choose \"Reopen in Container\""
}

main ${1+"$@"}
