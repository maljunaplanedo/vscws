{
  "description": "C++: GCC, latest stable LLVM (clang, clangd, lldb), latest CMake, ninja, ccache",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "cmake.generator": "Ninja",
        "cmake.configureOnOpen": true,
        "clangd.fallbackFlags": [
          "-std=c++23"
        ]
      }
    }
  },
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ]
}
