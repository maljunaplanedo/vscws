{
  "description": "Go: latest stable toolchain, gopls, delve, golangci-lint",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest",
      "golangciLintVersion": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.lintTool": "golangci-lint-v2",
        "go.alternateTools": {
          "golangci-lint-v2": "/go/bin/golangci-lint"
        }
      }
    }
  }
}
